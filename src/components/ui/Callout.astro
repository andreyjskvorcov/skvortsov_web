---
interface Props {
  type?: 'info' | 'tip' | 'warning' | 'danger';
  title?: string;
}

const titles = {
  info: 'Заметка',
  tip: 'Совет',
  warning: 'Внимание',
  danger: 'Опасно',
};

const { type = 'info', title = titles[type] } = Astro.props;
---

<aside class:list={['callout', `callout--${type}`]}>
  <p class="callout__title">{title}</p>
  <slot />
</aside>

<style>
  .callout {
    margin: var(--space-6) 0;
    padding: var(--space-4);
    border-left: 4px solid var(--accent);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  .callout--info {
    --accent: var(--color-info);
  }
  .callout--tip {
    --accent: var(--color-success);
  }
  .callout--warning {
    --accent: var(--color-warning);
  }
  .callout--danger {
    --accent: var(--color-danger);
  }
  .callout__title {
    margin: 0 0 var(--space-2);
    font-weight: 700;
    color: var(--accent);
  }
  .callout :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
