---
import ThemeToggle from '@/components/blocks/ThemeToggle.astro';

const nav = [
  { href: '/learn/js', label: 'JS' },
  { href: '/learn/vue', label: 'Vue' },
  { href: '/learn/react', label: 'React' },
  { href: '/learn/frontend', label: 'Frontend' },
  { href: '/projects', label: 'Проекты' },
  { href: '/ui-kit', label: 'UI-kit' },
];

const path = Astro.url.pathname;
---

<header class="border-b">
  <div class="page-container flex min-h-14 flex-wrap items-center gap-6">
    <a class="font-extrabold text-foreground no-underline" href="/">skvortsov.web</a>
    <nav class="flex flex-1 flex-wrap gap-4" aria-label="Основная навигация">
      {
        nav.map((item) => (
          <a
            class="text-muted-foreground no-underline transition-colors hover:text-foreground aria-[current=page]:text-foreground"
            href={item.href}
            aria-current={path.startsWith(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
</header>
