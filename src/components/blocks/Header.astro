---
import ThemeToggle from '@/components/ui/ThemeToggle.astro';

const nav = [
  { href: '/learn/js', label: 'JS' },
  { href: '/learn/vue', label: 'Vue' },
  { href: '/learn/react', label: 'React' },
  { href: '/learn/frontend', label: 'Frontend' },
  { href: '/ui-kit', label: 'UI-kit' },
];

const path = Astro.url.pathname;
---

<header class="header">
  <div class="container header__inner">
    <a class="header__logo" href="/">skvortsov.web</a>
    <nav class="header__nav" aria-label="Основная навигация">
      {
        nav.map((item) => (
          <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  .header {
    border-bottom: 1px solid var(--color-border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 3.5rem;
    flex-wrap: wrap;
  }
  .header__logo {
    font-weight: 800;
    color: var(--color-text);
    text-decoration: none;
  }
  .header__nav {
    display: flex;
    gap: var(--space-4);
    flex: 1;
    flex-wrap: wrap;
  }
  .header__nav a {
    color: var(--color-text-muted);
    text-decoration: none;
  }
  .header__nav a:hover,
  .header__nav a[aria-current='page'] {
    color: var(--color-text);
  }
</style>
