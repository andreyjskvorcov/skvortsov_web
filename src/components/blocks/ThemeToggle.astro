---
import { SunMoon } from 'lucide-react';
import { buttonVariants } from '@skvortsov/ui-react/button';
---

<button
  class:list={['theme-toggle', buttonVariants({ variant: 'outline', size: 'icon' })]}
  type="button"
  aria-label="Переключить тему"
>
  <SunMoon aria-hidden="true" />
</button>

<script>
  import { toggleTheme } from '@skvortsov/shared/theme';

  document.querySelector<HTMLButtonElement>('.theme-toggle')?.addEventListener('click', toggleTheme);
</script>
