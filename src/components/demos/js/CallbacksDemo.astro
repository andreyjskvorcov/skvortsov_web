---
import { buttonVariants } from '@/components/ui/button';
---

<div class="not-prose my-6 grid gap-6 rounded-lg border border-dashed p-4" data-callbacks-demo>
  <div class="grid gap-2">
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" class={buttonVariants()} data-start>Запустить</button>
      <span class="text-sm" data-message>Нажмите кнопку</span>
    </div>
  </div>

  <div class="grid gap-3 border-t pt-4">
    <div class="flex flex-wrap items-center gap-3">
      <button type="button" class={buttonVariants({ variant: 'outline' })} data-load>Загрузить посты</button>
      <span class="text-sm text-muted-foreground" data-status></span>
    </div>
    <ul class="grid gap-3" data-output></ul>
  </div>
</div>

<script>
  type Post = { id: number; title: string; body: string };

  for (const demo of document.querySelectorAll<HTMLElement>('[data-callbacks-demo]')) {
    const startButton = demo.querySelector<HTMLButtonElement>('[data-start]')!;
    const message = demo.querySelector<HTMLElement>('[data-message]')!;
    const loadButton = demo.querySelector<HTMLButtonElement>('[data-load]')!;
    const status = demo.querySelector<HTMLElement>('[data-status]')!;
    const output = demo.querySelector<HTMLUListElement>('[data-output]')!;

    // --- 1. Ждём и показываем ---
    function waitAndShow(callback: () => void) {
      message.textContent = 'Ждём…';
      startButton.disabled = true;

      setTimeout(() => {
        callback();
        startButton.disabled = false;
      }, 2000);
    }

    function showDone() {
      message.textContent = 'Готово!';
    }

    startButton.addEventListener('click', () => waitAndShow(showDone));

    // --- 2. Загрузка постов ---
    function getPosts(onSuccess: (posts: Post[]) => void, onError: (error: Error) => void) {
      fetch('https://jsonplaceholder.typicode.com/posts?_limit=3')
        .then((response) => {
          if (!response.ok) throw new Error(`Ошибка: код ${response.status}`);
          return response.json();
        })
        .then(onSuccess, onError);
    }

    function showPosts(posts: Post[]) {
      status.textContent = `Получено постов: ${posts.length}`;
      output.replaceChildren(
        ...posts.map((post) => {
          const item = document.createElement('li');
          item.className = 'rounded-md border bg-card p-3';

          const title = document.createElement('p');
          title.className = 'font-semibold';
          title.textContent = post.title;

          const body = document.createElement('p');
          body.className = 'mt-1 text-sm text-muted-foreground';
          body.textContent = post.body;

          item.append(title, body);
          return item;
        }),
      );
      loadButton.disabled = false;
    }

    function showError(error: Error) {
      status.textContent = `Ошибка загрузки: ${error.message}`;
      loadButton.disabled = false;
    }

    loadButton.addEventListener('click', () => {
      status.textContent = 'Загружаем…';
      output.replaceChildren();
      loadButton.disabled = true;
      getPosts(showPosts, showError);
    });
  }
</script>
