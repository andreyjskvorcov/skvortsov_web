---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { Badge } from '@/components/ui/badge';
import BackToTop from '@/components/blocks/BackToTop.astro';
import { sections, type SectionId } from '@/lib/sections';

interface Props {
  title: string;
  description?: string;
  section: SectionId;
  level?: 'beginner' | 'middle' | 'advanced';
}

const { title, description, section, level } = Astro.props;

const lessons = (await getCollection('lessons', (l) => l.data.section === section && !l.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const path = Astro.url.pathname.replace(/\/$/, '');
const index = lessons.findIndex((l) => `/learn/${l.id}` === path);
const prev = index > 0 ? lessons[index - 1] : undefined;
const next = index >= 0 ? lessons[index + 1] : undefined;

const levels = { beginner: 'Начальный', middle: 'Средний', advanced: 'Продвинутый' };
---

<BaseLayout title={title} description={description}>
  <div class="page-container grid gap-6 pt-8 pb-12 md:grid-cols-[15rem_minmax(0,1fr)] md:gap-12">
    <nav aria-label={`Уроки: ${sections[section].title}`}>
      <p class="mb-2">
        <a class="font-bold text-foreground no-underline" href={`/learn/${section}`}>{sections[section].title}</a>
      </p>
      <ol>
        {
          lessons.map((l) => (
            <li>
              <a
                class="block py-1 text-muted-foreground no-underline transition-colors hover:text-foreground aria-[current=page]:font-semibold aria-[current=page]:text-primary"
                href={`/learn/${l.id}`}
                aria-current={`/learn/${l.id}` === path ? 'page' : undefined}
              >
                {l.data.title}
              </a>
            </li>
          ))
        }
      </ol>
    </nav>

    <article class="max-w-3xl">
      <h1>{title}</h1>
      {level && <Badge variant="secondary">{levels[level]}</Badge>}
      <div class="prose mt-6 max-w-none">
        <slot />
      </div>

      <nav class="mt-12 flex justify-between gap-4 border-t pt-6" aria-label="Соседние уроки">
        {prev ? <a class="text-primary hover:underline" href={`/learn/${prev.id}`}>← {prev.data.title}</a> : <span />}
        {next && <a class="text-primary hover:underline" href={`/learn/${next.id}`}>{next.data.title} →</a>}
      </nav>
    </article>
  </div>
  <BackToTop />
</BaseLayout>
