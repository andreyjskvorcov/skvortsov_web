---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Callout from '@/components/blocks/Callout.tsx';
import LinkCard from '@/components/blocks/LinkCard.astro';
import { Badge } from '@/components/ui/badge';
import { Button } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardHeader, CardTitle } from '@/components/ui/card';

const colors = [
  'background',
  'foreground',
  'card',
  'muted',
  'muted-foreground',
  'border',
  'primary',
  'secondary',
  'accent',
  'destructive',
  'info',
  'success',
  'warning',
];

const buttonVariants = ['default', 'secondary', 'outline', 'ghost', 'destructive', 'link'] as const;
const badgeVariants = ['default', 'secondary', 'outline', 'destructive'] as const;
---

<BaseLayout title="UI-kit" description="Витрина компонентов и дизайн-токенов">
  <div class="page-container pt-8 pb-12 [&>section]:mb-12">
    <h1>UI-kit</h1>
    <p class="mb-8 text-muted-foreground">
      Компоненты <a class="text-primary hover:underline" href="https://ui.shadcn.com">shadcn/ui</a> на токенах
      из <code>src/styles/tokens.css</code>.
    </p>

    <section>
      <h2>Цвета</h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(13rem,1fr))] gap-3">
        {
          colors.map((c) => (
            <div class="flex items-center gap-2">
              <span class="size-8 flex-none rounded-sm border" style={`background: var(--${c})`} />
              <code>--{c}</code>
            </div>
          ))
        }
      </div>
    </section>

    <section>
      <h2>Button</h2>
      <div class="flex flex-wrap items-center gap-3">
        {buttonVariants.map((v) => <Button variant={v}>{v}</Button>)}
      </div>
      <div class="mt-3 flex flex-wrap items-center gap-3">
        <Button size="sm">sm</Button>
        <Button>default</Button>
        <Button size="lg">lg</Button>
      </div>
    </section>

    <section>
      <h2>Badge</h2>
      <div class="flex flex-wrap items-center gap-3">
        {badgeVariants.map((v) => <Badge variant={v}>{v}</Badge>)}
      </div>
    </section>

    <section>
      <h2>Card</h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(16rem,1fr))] gap-4">
        <Card>
          <CardHeader>
            <CardTitle>Обычная карточка</CardTitle>
            <CardDescription>Описание карточки.</CardDescription>
          </CardHeader>
          <CardContent>Контент карточки.</CardContent>
        </Card>
        <LinkCard title="Карточка-ссылка" description="Кликабельна целиком." href="/learn" />
      </div>
    </section>

    <section>
      <h2>Callout</h2>
      <Callout type="info">Информационная заметка.</Callout>
      <Callout type="tip">Полезный совет.</Callout>
      <Callout type="warning">Обратите внимание.</Callout>
      <Callout type="danger">Так делать не стоит.</Callout>
    </section>
  </div>
</BaseLayout>
