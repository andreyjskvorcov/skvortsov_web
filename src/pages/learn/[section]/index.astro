---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import LinkCard from '@/components/blocks/LinkCard.astro';
import { sections, sectionIds, type SectionId } from '@/lib/sections';

export function getStaticPaths() {
  return sectionIds.map((section) => ({ params: { section } }));
}

const section = Astro.params.section as SectionId;
const lessons = (await getCollection('lessons', (l) => l.data.section === section && !l.data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout title={sections[section].title} description={sections[section].description}>
  <div class="page-container pt-8 pb-12">
    <h1>{sections[section].title}</h1>
    <p class="text-muted-foreground">{sections[section].description}</p>
    {lessons.length === 0 && <p class="mt-6">Уроки скоро появятся.</p>}
    <ol class="mt-6 grid gap-3">
      {
        lessons.map((l) => (
          <li>
            <LinkCard title={l.data.title} description={l.data.description} href={`/learn/${l.id}`} />
          </li>
        ))
      }
    </ol>
  </div>
</BaseLayout>
