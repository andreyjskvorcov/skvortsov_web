---
import BaseLayout from '@/layouts/BaseLayout.astro';
import LinkCard from '@/components/blocks/LinkCard.astro';
import { sections, sectionIds } from '@/lib/sections';
---

<BaseLayout title="Обучение">
  <div class="page-container pt-8 pb-12">
    <h1>Обучение</h1>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(16rem,1fr))] gap-4">
      {sectionIds.map((id) => <LinkCard title={sections[id].title} description={sections[id].description} href={`/learn/${id}`} />)}
    </div>
  </div>
</BaseLayout>
