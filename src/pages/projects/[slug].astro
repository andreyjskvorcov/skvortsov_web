---
import { getCollection, render } from 'astro:content';
import { ExternalLink } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { appUrl, projectTypes, stacks } from '@/lib/projects';

export async function getStaticPaths() {
  const projects = await getCollection('projects', (p) => !p.data.draft);
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { title, description, stack, type, tags, repo } = project.data;
const { Content } = await render(project);
const src = appUrl(project.id);
---

<BaseLayout title={title} description={description}>
  <div class="page-container pt-8 pb-12">
    <a class="text-sm text-muted-foreground no-underline hover:text-foreground" href="/projects">← Все проекты</a>

    <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="mb-2">{title}</h1>
        <p class="text-muted-foreground">{description}</p>
      </div>
      <div class="flex gap-2">
        {
          type === 'app' && (
            <a class={buttonVariants({ variant: 'outline' })} href={src} target="_blank" rel="noopener">
              Открыть отдельно <ExternalLink />
            </a>
          )
        }
        {
          repo && (
            <a class={buttonVariants({ variant: 'outline' })} href={repo} target="_blank" rel="noopener">
              Исходники <ExternalLink />
            </a>
          )
        }
      </div>
    </div>

    <div class="mt-4 flex flex-wrap gap-2">
      <Badge>{stacks[stack]}</Badge>
      <Badge variant="secondary">{projectTypes[type]}</Badge>
      {tags.map((t) => <Badge variant="outline">{t}</Badge>)}
    </div>

    {
      type === 'app' && (
        <iframe
          class="mt-8 h-[36rem] w-full rounded-xl border bg-background"
          src={src}
          title={title}
          loading="lazy"
        />
      )
    }

    <div class="prose mt-8 max-w-3xl">
      <Content />
    </div>
  </div>
</BaseLayout>
