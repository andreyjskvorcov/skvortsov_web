---
import { getCollection } from 'astro:content';
import { BookOpen, Download } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { Card, CardContent, CardDescription, CardFooter, CardHeader, CardTitle } from '@/components/ui/card';
import { getBookFile, isBookVisible } from '@/lib/books';

const books = (await getCollection('books', isBookVisible))
  .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title))
  .map((book) => ({ ...book, pdf: getBookFile(book.data.file, book.data.private) }));
---

<BaseLayout title="Книги" description="Книги и материалы для чтения онлайн">
  <div class="page-container pt-8 pb-12">
    <h1>Книги</h1>
    <p class="mb-6 max-w-2xl text-muted-foreground">Материалы, которые можно читать прямо на сайте или скачать в PDF.</p>

    {books.length === 0 && <p>Книги скоро появятся.</p>}

    <div class="grid grid-cols-[repeat(auto-fill,minmax(17rem,1fr))] gap-4">
      {
        books.map((book) => (
          <Card className="h-full">
            {book.data.cover && (
              <img
                class="-mt-6 aspect-[3/4] w-full rounded-t-xl border-b object-cover"
                src={book.data.cover}
                alt={`Обложка: ${book.data.title}`}
                loading="lazy"
              />
            )}
            <CardHeader>
              <CardTitle>
                <a class="text-foreground no-underline hover:text-primary" href={`/books/${book.id}`}>
                  {book.data.title}
                </a>
              </CardTitle>
              <CardDescription>
                {book.data.author}
                {book.data.year && `, ${book.data.year}`}
              </CardDescription>
            </CardHeader>
            <CardContent className="flex-1 text-sm">{book.data.description}</CardContent>
            <CardFooter className="flex-wrap gap-2">
              <a class={buttonVariants({ size: 'sm' })} href={`/books/${book.id}`}>
                <BookOpen /> Читать
              </a>
              <a class={buttonVariants({ size: 'sm', variant: 'outline' })} href={book.pdf.url} download>
                <Download /> PDF, {book.pdf.size}
              </a>
              {book.data.private && <Badge variant="outline">Личная — только локально</Badge>}
              {book.data.tags.map((tag) => (
                <Badge variant="secondary">{tag}</Badge>
              ))}
            </CardFooter>
          </Card>
        ))
      }
    </div>
  </div>
</BaseLayout>
