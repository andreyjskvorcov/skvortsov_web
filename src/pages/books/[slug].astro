---
import { getCollection, render } from 'astro:content';
import { Download, ExternalLink } from 'lucide-react';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { buttonVariants } from '@/components/ui/button';
import { getBookFile, isBookVisible } from '@/lib/books';

export async function getStaticPaths() {
  const books = await getCollection('books', isBookVisible);
  return books.map((book) => ({ params: { slug: book.id }, props: { book } }));
}

const { book } = Astro.props;
const { title, author, year, description } = book.data;
const pdf = getBookFile(book.data.file, book.data.private);
const { Content } = await render(book);
---

<BaseLayout title={title} description={description}>
  <div class="page-container pt-8 pb-12">
    <a class="text-sm text-muted-foreground no-underline hover:text-foreground" href="/books">← Все книги</a>

    <div class="mt-4 flex flex-wrap items-start justify-between gap-4">
      <div>
        <h1 class="mb-2">{title}</h1>
        <p class="text-muted-foreground">
          {author}{year && `, ${year}`}
        </p>
      </div>
      <div class="flex flex-wrap gap-2">
        <a class={buttonVariants({ variant: 'outline' })} href={pdf.url} target="_blank" rel="noopener">
          Открыть в новой вкладке <ExternalLink />
        </a>
        <a class={buttonVariants()} href={pdf.url} download>
          <Download /> Скачать PDF, {pdf.size}
        </a>
      </div>
    </div>

    <!-- Встроенный просмотрщик PDF браузера. На телефонах он есть не везде — поэтому выше кнопки открыть и скачать -->
    <iframe
      class="mt-6 h-[85vh] w-full rounded-xl border bg-muted"
      src={`${pdf.url}#view=FitH`}
      title={`Книга: ${title}`}
    ></iframe>
    <p class="mt-2 text-sm text-muted-foreground">
      Если книга не отображается, откройте её в новой вкладке или скачайте.
    </p>

    <div class="prose mt-8 max-w-3xl">
      <Content />
    </div>
  </div>
</BaseLayout>
